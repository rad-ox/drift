          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/toml-value"
          },
          "type": "object"
        }
      ]
    },
    "use": {
      "additionalProperties": {
        "type": [
          "string",
          "integer",
          "number",
          "boolean"
        ]
      },
      "properties": {
        "concepts": {
          "description": "Adopted <ctx>.<id> concepts",
          "items": {
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "params": {
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "number",
              "boolean"
            ]
          },
          "description": "Profile parameter values",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": "object"
        },
        "profile": {
          "description": "Profile ref (<name>@<N>)",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*@[1-9][0-9]*$",
