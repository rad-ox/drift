          "description": "Summary (<=100 chars)",
          "maxLength": 100,
          "type": "string"
        },
        "effort_h": {
          "description": "Estimated hours",
          "minimum": 0,
          "type": "number"
        },
        "leverage": {
          "description": "Leverage ('1/4'..'4/4')",
          "enum": [
            "1/4",
            "2/4",
            "3/4",
            "4/4"
          ]
        },
