        },
        {
          "required": [
            "forbid_imports"
          ]
        },
        {
          "required": [
            "forbid_touched"
          ]
        },
        {
          "required": [
            "require_containment"
          ]
        }
      ],
      "properties": {
        "forbid_imports": {
          "description": "Forbidden import prefixes",
