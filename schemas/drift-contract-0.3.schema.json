{
  "$defs": {
    "approval": {
      "additionalProperties": false,
      "properties": {
        "assurance_ref": {
          "description": "0.3 assurance seal (dr2a:)",
          "pattern": "^dr2a:(?:sha256:[0-9a-f]{64}|[0-9a-f]{12})$",
          "type": "string"
        },
        "at": {
          "description": "UTC RFC 3339 approval time",
          "format": "date-time",
          "type": "string"
        },
        "behavior_ref": {
          "description": "0.3 behavioral seal (dr2b:)",
          "pattern": "^dr2b:(?:sha256:[0-9a-f]{64}|[0-9a-f]{12})$",
          "type": "string"
        },
        "by": {
          "description": "Approving owner ID",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "behavior_ref",
        "assurance_ref",
        "by",
        "at"
      ],
      "type": "object"
    },
    "artifact-ref": {
      "pattern": "^(?:sha256:[0-9a-f]{64}|(?:dr1|dr2b|dr2a|dr2r|dr2x):(?:sha256:[0-9a-f]{64}|[0-9a-f]{12}))$",
      "type": "string"
    },
    "assurance": {
      "additionalProperties": false,
      "properties": {
        "budgets": {
          "additionalProperties": {
            "$ref": "#/$defs/budget"
          },
          "description": "Performance budgets",
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": "object"
        },
        "controls": {
          "additionalProperties": {
            "$ref": "#/$defs/control"
          },
          "description": "Risk-mitigating controls",
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": "object"
        },
        "cutover": {
          "$ref": "#/$defs/cutover",
          "description": "Parity and migration cutover gate"
        },
        "formal": {
          "additionalProperties": {
            "$ref": "#/$defs/formal"
          },
          "description": "Formal verification obligations",
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": "object"
        },
        "guards": {
          "$ref": "#/$defs/guards",
          "description": "Line-count and import guards"
        },
        "risks": {
          "additionalProperties": {
            "$ref": "#/$defs/risk"
          },
          "description": "Declared risks",
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "bind": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "Owned globs or <path>#<symbol>",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "sources": {
          "description": "Spec, ADR, or schema files",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "budget": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "metric": {
                "not": {
                  "enum": [
                    "tick_alloc_bytes",
                    "tick_alloc_count",
                    "alloc_bytes_total",
                    "alloc_count_total"
                  ]
                }
              }
            }
          },
          "then": {
            "properties": {
              "limit": {
                "exclusiveMinimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": {
                "const": "cpu_time_ns"
              }
            }
          },
          "then": {
            "properties": {
              "limit": {
                "type": "integer"
              }
            }
          }
        }
      ],
      "properties": {
        "aggregation": {
          "description": "Statistic (p50, p95, p99, max, mean)",
          "enum": [
            "p99",
            "rate",
            "max_observed"
          ]
        },
        "baseline_ref": {
          "$ref": "#/$defs/artifact-ref",
          "description": "Baseline receipt for regression"
        },
        "case": {
          "description": "Exercised contract case",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "enforce": {
          "description": "Gated phase (execution/release)",
          "enum": [
            "execution",
            "release"
          ]
        },
        "environment_ref": {
          "$ref": "#/$defs/artifact-ref",
          "description": "Required runner environment"
        },
        "evidence": {
          "description": "Measurement evidence mode",
          "enum": [
            "statistical",
            "observed"
          ]
        },
        "limit": {
          "description": "Threshold in declared unit",
          "minimum": 0,
          "type": "number"
        },
        "max_regression": {
          "description": "Max relative degradation",
          "minimum": 0,
          "type": "number"
        },
        "metric": {
          "description": "Measured metric kind",
          "enum": [
            "request_latency",
            "successful_throughput",
            "process_rss",
            "frame_time",
            "cold_start",
            "artifact_bytes",
            "work_units",
            "tick_alloc_bytes",
            "tick_alloc_count",
            "alloc_bytes_total",
            "alloc_count_total",
            "frame_hitch_ns",
            "cpu_time_ns"
          ]
        },
        "min_confidence": {
          "description": "Minimum confidence level",
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "note": {
          "description": "Budget note",
          "type": "string"
        },
        "op": {
          "description": "Comparison operator",
          "enum": [
            "le",
            "ge"
          ]
        },
        "protocol_ref": {
          "$ref": "#/$defs/artifact-ref",
          "description": "Sampling/warmup protocol"
        },
        "unit": {
          "description": "Unit (ms, us, ns, B, req_per_s)",
          "enum": [
            "ns",
            "request/s",
            "byte",
            "count"
          ]
        },
        "warn_ratio": {
          "description": "Advisory warning ratio",
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "workload_ref": {
          "$ref": "#/$defs/artifact-ref",
          "description": "Workload definition ref"
        }
      },
      "required": [
        "case",
        "metric",
        "unit",
        "aggregation",
        "op",
        "limit",
        "evidence",
        "enforce",
        "workload_ref",
        "protocol_ref",
        "environment_ref"
      ],
      "type": "object"
    },
    "case": {
      "additionalProperties": false,
      "dependentRequired": {
        "because": [
          "status"
        ],
        "status": [
          "because"
        ]
      },
      "properties": {
        "at": {
          "description": "Target verification levels",
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "because": {
          "description": "Reason for non-active status",
          "minLength": 1,
          "type": "string"
        },
        "note": {
          "description": "Case note outside digest",
          "type": "string"
        },
        "scenario": {
          "description": "Readable scenario label",
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "description": "Exemption (deferred/reviewed)",
          "enum": [
            "deferred",
            "reviewed"
          ]
        },
        "then": {
          "additionalProperties": {
            "$ref": "#/$defs/constraint-value"
          },
          "description": "Expected postcondition clauses",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": "object"
        },
        "when": {
          "additionalProperties": {
            "$ref": "#/$defs/constraint-value"
          },
          "description": "Input precondition clauses",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": "object"
        },
        "writes": {
          "description": "Allowed writes ([] = pure read)",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "then"
      ],
      "type": "object"
    },
    "constraint-expr": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "eq"
          ]
        },
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "max"
          ]
        },
        {
          "required": [
            "len"
          ]
        },
        {
          "required": [
            "in"
          ]
        },
        {
          "required": [
            "not_in"
          ]
        },
        {
          "required": [
            "contains"
          ]
        },
        {
          "required": [
            "prefix"
          ]
        },
        {
          "required": [
            "suffix"
          ]
        },
        {
          "required": [
            "keys"
          ]
        },
        {
          "required": [
            "peer"
          ]
        },
        {
          "required": [
            "series"
          ]
        }
      ],
      "properties": {
        "contains": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "items": {
                "$ref": "#/$defs/toml-value"
              },
              "minItems": 1,
              "type": "array"
            }
          ],
          "description": "Required substring/element"
        },
        "convert_from": {
          "description": "Source unit in [units]",
          "minLength": 1,
          "type": "string"
        },
        "eq": {
          "$ref": "#/$defs/toml-value",
          "description": "Exact expected value"
        },
        "in": {
          "description": "Allowed value set",
          "items": {
            "$ref": "#/$defs/toml-value"
          },
          "minItems": 1,
          "type": "array"
        },
        "keys": {
          "additionalProperties": false,
          "description": "Map key allow/forbid rules",
          "minProperties": 1,
          "properties": {
            "allow": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "forbid": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          },
          "type": "object"
        },
        "len": {
          "additionalProperties": false,
          "description": "Length bounds ({min, max})",
          "minProperties": 1,
          "properties": {
            "max": {
              "type": [
                "integer",
                "string"
              ]
            },
            "min": {
              "type": [
                "integer",
                "string"
              ]
            }
          },
          "type": "object"
        },
        "max": {
          "description": "Inclusive upper bound",
          "type": [
            "number",
            "string"
          ]
        },
        "min": {
          "description": "Inclusive lower bound",
          "type": [
            "number",
            "string"
          ]
        },
        "not_in": {
          "description": "Forbidden value set",
          "items": {
            "$ref": "#/$defs/toml-value"
          },
          "minItems": 1,
          "type": "array"
        },
        "peer": {
          "additionalProperties": false,
          "description": "Sibling predicate coupling",
          "minProperties": 1,
          "properties": {
            "balance": {
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "add": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "sub": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                }
              },
              "type": "object"
            },
            "eq": {
              "minLength": 1,
              "type": "string"
            },
            "ge": {
              "minLength": 1,
              "type": "string"
            },
            "le": {
              "minLength": 1,
              "type": "string"
            },
            "sum": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "type": "object"
        },
        "prefix": {
          "description": "Required string prefix",
          "minLength": 1,
          "type": "string"
        },
        "series": {
          "additionalProperties": false,
          "description": "Sequence invariant",
          "minProperties": 1,
          "properties": {
            "monotonic": {
              "enum": [
                "non_decreasing",
                "increasing",
                "non_increasing",
                "decreasing"
              ]
            },
            "step_max_delta": {
              "type": [
                "number",
                "string"
              ]
            },
            "sum_total": {
              "type": [
                "number",
                "string"
              ]
            }
          },
          "type": "object"
        },
        "suffix": {
          "description": "Required string suffix",
          "minLength": 1,
          "type": "string"
        },
        "tol": {
          "additionalProperties": false,
          "description": "Tolerance ({abs, rel})",
          "minProperties": 1,
          "properties": {
            "abs": {
              "minimum": 0,
              "type": "number"
            },
            "rel": {
              "minimum": 0,
              "type": "number"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "constraint-value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/toml-value"
          },
          "type": "array"
        },
        {
          "$ref": "#/$defs/constraint-expr"
        }
      ]
    },
    "control": {
      "additionalProperties": false,
      "properties": {
        "cases": {
          "description": "Verifying cases",
          "items": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "context_ref": {
          "description": "Validity-context ref",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "criteria_ref": {
          "description": "Acceptance criteria ref",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "effectiveness_evidence": {
          "description": "Effectiveness receipt kinds",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "enforce": {
          "description": "Gated phase",
          "enum": [
            "execution",
            "release"
          ]
        },
        "implementation_evidence": {
          "description": "Implementation receipt kinds",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "kind": {
          "description": "preventive, detective, corrective",
          "enum": [
            "software",
            "interface",
            "procedure",
            "hardware"
          ]
        },
        "mitigates": {
          "description": "Mitigated risk IDs",
          "items": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "note": {
          "description": "Control note",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "mitigates"
      ],
      "type": "object"
    },
    "cutover": {
      "additionalProperties": false,
      "properties": {
        "candidate_target": {
          "description": "Candidate target ID",
          "minLength": 1,
          "type": "string"
        },
        "corpus_ref": {
          "description": "Replay corpus ID",
          "pattern": "^(?:sha256:[0-9a-f]{64}|(?:dr1|dr2b):(?:sha256:[0-9a-f]{64}|[0-9a-f]{12}))$",
          "type": "string"
        },
        "enforce": {
          "description": "Parity gate phase",
          "enum": [
            "release",
            "always"
          ]
        },
        "intentional_diffs": {
          "description": "Allowed parity diffs",
          "items": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "legacy_target": {
          "description": "Legacy baseline ID",
          "minLength": 1,
          "type": "string"
        },
        "migration_ids": {
          "description": "Required migration epochs",
          "items": {
            "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*|[a-z][a-z0-9_]*)$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "normalization_ref": {
          "description": "Payload normalization ref",
          "pattern": "^(?:sha256:[0-9a-f]{64}|(?:dr1|dr2b):(?:sha256:[0-9a-f]{64}|[0-9a-f]{12}))$",
          "type": "string"
        },
        "note": {
          "description": "Cutover note",
          "type": "string"
        },
        "rollback_readback": {
          "description": "Require rollback parity",
          "enum": [
            "required",
            "not_applicable"
          ]
        }
      },
      "required": [
        "legacy_target",
        "candidate_target",
        "normalization_ref",
        "corpus_ref"
      ],
      "type": "object"
    },
    "decision": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "assumption",
                  "divergence"
                ]
              }
            }
          },
          "then": {
            "required": [
              "source"
            ]
          }
        },
        {
          "else": {
            "required": [
              "revisit_if"
            ]
          },
          "if": {
            "properties": {
              "evidence": {
                "const": "observed"
              }
            }
          },
          "then": {}
        }
      ],
      "properties": {
        "ask": {
          "description": "Question (<=120 chars)",
          "maxLength": 120,
          "type": "string"
        },
        "cases": {
          "description": "Affected cases",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "decide_by": {
          "description": "Phase deadline for pick",
          "enum": [
            "approval",
            "execution",
            "release"
          ]
        },
        "evidence": {
          "description": "observed, inferred, assumed",
          "enum": [
            "observed",
            "inferred",
            "assumed"
          ]
        },
        "kind": {
          "description": "choice, assumption, divergence",
          "enum": [
            "choice",
            "assumption",
            "divergence"
          ]
        },
        "note": {
          "description": "Prose outside digest",
          "type": "string"
        },
        "options": {
          "additionalProperties": {
            "$ref": "#/$defs/option"
          },
          "description": "1..4 candidate options",
          "maxProperties": 4,
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": "object"
        },
        "owner": {
          "description": "Decision owner",
          "type": "string"
        },
        "pick": {
          "description": "Chosen option ID or ''",
          "type": "string"
        },
        "revisit_if": {
          "description": "Reopen condition",
          "type": "string"
        },
        "source": {
          "description": "Supporting spec/ADR/file",
          "type": "string"
        },
        "why": {
          "description": "Rationale for costlier pick",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ask",
        "pick",
        "cases",
        "evidence",
        "options"
      ],
      "type": "object"
    },
    "formal": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "linkage": {
                "const": "in_code_harness"
              }
            }
          },
          "then": {
            "required": [
              "harness"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "property_kind": {
                "const": "liveness"
              }
            }
          },
          "then": {
            "required": [
              "fairness"
            ]
          }
        }
      ],
      "properties": {
        "cases": {
          "description": "Backed cases",
          "items": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "domain_bounds": {
          "additionalProperties": {
            "minimum": 1,
            "type": "integer"
          },
          "description": "Required unwind/bit bounds",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "loop_unwind",
              "max_preemptions",
              "max_steps",
              "max_threads",
              "input_bytes",
              "qubits",
              "ansatz_layers",
              "circuit_depth"
            ]
          },
          "type": "object"
        },
        "enforce": {
          "description": "Formal gate phase",
          "enum": [
            "execution",
            "release"
          ]
        },
        "fairness": {
          "description": "Liveness fairness rule",
          "enum": [
            "none",
            "weak",
            "strong"
          ]
        },
        "harness": {
          "description": "In-code <path>#<symbol>",
          "minLength": 3,
          "type": "string"
        },
        "linkage": {
          "description": "in_code_harness/external_model",
          "enum": [
            "in_code_harness",
            "conformance_traced",
            "declared_model"
          ]
        },
        "min_evidence": {
          "description": "Minimum proof depth",
          "enum": [
            "deductive",
            "bounded_exhaustive",
            "sampled_exploration"
          ]
        },
        "note": {
          "description": "Formal note",
          "type": "string"
        },
        "property": {
          "description": "Formal property ID",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "type": "string"
        },
        "property_kind": {
          "description": "safety, liveness, equivalence",
          "enum": [
            "safety",
            "liveness",
            "unitary_equivalence"
          ]
        },
        "verifier": {
          "description": "Formal tool name",
          "enum": [
            "kani",
            "loom",
            "tlc",
            "cbmc",
            "alloy",
            "spin",
            "shuttle",
            "stateright",
            "dafny",
            "qcec",
            "gappa"
          ]
        }
      },
      "required": [
