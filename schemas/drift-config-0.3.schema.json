{
  "$defs": {
    "approval": {
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "ref"
          ]
        },
        {
          "required": [
            "digest"
          ]
        }
      ],
      "properties": {
        "at": {
          "format": "date-time",
          "type": "string"
        },
        "by": {
          "minLength": 1,
          "type": "string"
        },
        "digest": {
          "pattern": "^dr1:sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "ref": {
          "pattern": "^dr1:[0-9a-f]{12}$",
          "type": "string"
        }
      },
      "required": [
        "by",
        "at"
      ],
      "type": "object"
    }
  },
  "$id": "urn:drift:schemas:config:0.3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {
    "type": "object"
  },
  "allOf": [
    {
      "else": {
        "minProperties": 3
      },
      "if": {
        "required": [
          "approval"
        ]
      },
      "then": {
        "minProperties": 4
      }
    }
  ],
  "properties": {
    "approval": {
      "$ref": "#/$defs/approval"
    },
    "drift": {
      "const": "0.3"
    },
    "kind": {
      "const": "config"
    },
    "policy": {
      "if": {
        "required": [
          "pack"
        ]
      },
      "then": {
        "additionalProperties": false,
        "properties": {
          "approvers": {
            "items": {
              "pattern": "^\\S(?:.*\\S)?$",
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "companion_edits": {
            "enum": [
              "none",
              "imports_only"
            ]
          },
          "forbid_imports": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "grant_lock": {
            "pattern": "^dr2g:(?:sha256:[0-9a-f]{64}|[0-9a-f]{12})$",
            "type": "string"
          },
          "ignore": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "max_lines": {
            "minimum": 1,
            "type": "integer"
          },
          "max_open": {
            "minimum": 1,
            "type": "integer"
          },
          "pack": {
            "const": "core@1"
          },
          "performance_reuse": {
            "enum": [
              "off",
              "execution"
            ]
          },
          "priority_weights": {
            "additionalProperties": false,
            "properties": {
              "boundary_operator": {
                "maximum": 32,
                "minimum": 0,
                "type": "integer"
              },
              "fragile_card": {
                "maximum": 32,
                "minimum": 0,
                "type": "integer"
              },
              "security_case": {
                "maximum": 32,
                "minimum": 0,
                "type": "integer"
              },
              "shared_test": {
                "maximum": 32,
                "minimum": 0,
                "type": "integer"
              },
              "symmetric_witness": {
                "maximum": 32,
                "minimum": 0,
                "type": "integer"
              }
            },
            "type": "object"
          },
          "proof": {
            "enum": [
              "bound",
              "verified",
              "killed"
            ]
          },
          "security": {
            "items": {
              "enum": [
                "sast",
                "fuzz",
                "policy",
                "deps"
              ]
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "sweep": {
            "anyOf": [
              {
                "const": "soundness"
              },
              {
                "items": {
                  "const": "soundness"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              }
            ]
          },
          "warn_ratio": {
            "exclusiveMaximum": 1,
            "exclusiveMinimum": 0,
            "type": "number"
          }
        },
        "required": [
          "pack",
          "approvers",
          "proof"
        ]
      },
      "type": "object"
    }
  },
  "required": [
    "drift",
    "kind"
  ],
  "title": "DRIFT 0.3 configuration",
  "type": "object"
}
