{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rad-ox/drift/schemas/drift-proof-event-0.3.schema.json",
  "title": "DRIFT 0.3 Proof Event, Observation Envelope, Supervisor Session & Receipt Schemas",
  "description": "Normative schema for 0.3 JSONL proof events (<shard>.jsonl), test inventory sidecars (<shard>.meta.json), canonical observations (drift.observation/1), supervisor sessions (drift.bridge-session/1), and security/formal receipts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["test", "contract", "cases", "level", "outcome", "schema"],
  "properties": {
    "test": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical test identifier (<class-or-file>#<method>)."
    },
    "contract": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Contract identifier matching the contract file stem."
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "description": "Contract case identifiers covered by this test execution."
    },
    "level": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Verification level (for example unit, http, e2e)."
    },
    "outcome": {
      "type": "string",
      "enum": ["passed", "failed", "skipped", "disabled", "interrupted", "timeout"],
      "description": "Runtime outcome of the test execution."
    },
    "read": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "description": "Subset of cases for which the test read and checked every top-level then.<key> expectation."
    },
    "digest": {
      "type": "string",
      "pattern": "^dr2b:(?:sha256:[0-9a-f]{64}|[0-9a-f]{12})$",
      "description": "Canonical 0.3 behavior digest (dr2b:sha256:<64-hex>) or 12-hex reference (dr2b:<12-hex>)."
    },
    "schema": {
      "type": "string",
      "const": "0.3",
      "description": "Mandatory 0.3 proof event schema handshake."
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Bridge capability identifiers covering the resolved contract's required_capabilities."
    },
    "observations": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/observationEnvelope"
      },
      "description": "Optional drift.observation/1 envelope per case of this event (keys must be in cases); prove and gate re-judge each with the kernel oracle."
    }
  },
  "$defs": {
    "inventorySidecar": {
      "title": "DRIFT Test Inventory Sidecar (<shard>.meta.json)",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "classes", "tests"],
      "properties": {
        "version": {
          "type": "integer",
          "enum": [1, 2]
        },
        "classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^# \\t\\r\\n/\\\\\\[\\]]+$"
          }
        },
        "tests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^# \\t\\r\\n/\\\\\\[\\]]+#[^# \\t\\r\\n\\[\\]]+$"
          }
        },
        "snapshot": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "pack_ref": {
          "type": "string",
          "pattern": "^(?:dr1|dr2b):[0-9a-f]{12}$"
        },
        "execution_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "subject_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "touched": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)(?:\\.{1,2}|$)).+$"
          }
        },
        "self_stubbed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^# \\t\\r\\n/\\\\\\[\\]]+#[^# \\t\\r\\n\\[\\]]+$"
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": false,
          "required": ["toolchain", "deps", "config", "runner", "drift", "adapter", "policy"],
          "properties": {
            "toolchain": { "type": "string", "minLength": 1 },
            "deps": { "type": "string", "minLength": 1 },
            "config": { "type": "string", "minLength": 1 },
            "runner": { "type": "string", "minLength": 1 },
            "drift": { "type": "string", "minLength": 1 },
            "adapter": { "type": "string", "minLength": 1 },
            "policy": { "type": "string", "minLength": 1 }
          }
        },
        "shadow_run": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "run_id", "source_snapshot", "bindings_ref", "shadow_snapshot", "shadow_inputs"],
          "properties": {
            "schema": { "type": "string", "const": "drift.shadow-run/1" },
            "run_id": { "type": "string", "minLength": 1 },
            "source_snapshot": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
            "bindings_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "shadow_snapshot": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "sequence": { "type": "integer", "minimum": 1 },
            "supersedes": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "selected_tests": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "shadow_inputs": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": { "version": { "const": 1 } },
          "not": { "required": ["execution_ref"] }
        },
        {
          "properties": { "version": { "const": 2 } },
          "required": ["execution_ref"]
        }
      ]
    },
    "observationEnvelope": {
      "title": "DRIFT Canonical Observation Protocol Envelope (drift.observation/1)",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "outcome", "payload"],
      "properties": {
        "schema": { "type": "string", "const": "drift.observation/1" },
        "outcome": { "type": "string", "enum": ["returned", "thrown", "timeout", "interrupted"] },
        "payload": {
          "type": ["object", "array", "string", "number", "boolean", "null"]
        },
        "presence": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["exact", "null_collapsed", "absent_collapsed", "unobservable"]
          }
        },
        "frame": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "writes": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "reads": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "touched_symbols": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "init_only_symbols": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "bridgeSession": {
      "title": "DRIFT Bridge Supervisor Session Receipt (drift.bridge-session/1)",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "channel", "runner_exit", "oracle_failures", "incomplete_shards", "verdict_swallowed", "events"],
      "properties": {
        "schema": { "type": "string", "const": "drift.bridge-session/1" },
        "channel": { "type": "string", "enum": ["fd3", "named_pipe", "unix_socket"] },
        "runner_exit": { "type": "integer" },
        "oracle_failures": { "type": "integer", "minimum": 0 },
        "incomplete_shards": { "type": "integer", "minimum": 0 },
        "verdict_swallowed": { "type": "boolean" },
        "events": {
          "type": "array",
          "items": { "type": "object" }
        },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "securityReceipt": {
      "title": "DRIFT Security Check Receipt (<name>.security.json)",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "category", "tool", "tool_ref", "ruleset_ref", "contract", "digest", "code_snapshot", "covered_scope", "cases", "outcome"],
      "properties": {
        "kind": { "type": "string", "const": "security_check" },
        "category": { "type": "string", "enum": ["sast", "fuzz", "policy", "deps"] },
        "tool": { "type": "string", "minLength": 1 },
        "tool_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "ruleset_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "contract": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "digest": { "type": "string", "pattern": "^(?:dr1|dr2b):(?:sha256:[0-9a-f]{64}|[0-9a-f]{12})$" },
        "code_snapshot": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
        "covered_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "outcome": { "type": "string", "enum": ["passed", "violated", "inconclusive"] }
      }
    },
    "formalReceipt": {
      "title": "DRIFT Formal Verification Receipt (<name>.formal.json)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "contract", "digest", "formal_id", "requirement_ref",
        "verifier", "verifier_ref", "subject_ref", "subject_identity",
        "execution_determinism", "code_snapshot", "covered_scope", "cases",
        "verified_properties", "evidence_kind", "completion", "linkage", "outcome"
      ],
      "properties": {
        "schema": { "type": "string", "const": "drift.formal-receipt/1" },
        "contract": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "digest": { "type": "string", "pattern": "^(?:dr1|dr2b):(?:sha256:[0-9a-f]{64}|[0-9a-f]{12})$" },
        "formal_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "requirement_ref": { "type": "string", "pattern": "^(?:dr1|dr2r):sha256:[0-9a-f]{64}$" },
        "verifier": { "type": "string", "enum": ["kani", "loom", "tlc", "cbmc", "alloy", "spin", "shuttle", "stateright", "dafny", "qcec", "gappa"] },
        "verifier_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "subject_ref": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "subject_identity": { "type": "string", "enum": ["pinned", "opaque_external"] },
        "execution_determinism": { "type": "string", "enum": ["bitwise", "statistical"] },
        "code_snapshot": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
        "covered_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "verified_properties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_kind": { "type": "string", "enum": ["deductive", "bounded_exhaustive", "sampled_exploration"] },
        "completion": { "type": "string", "enum": ["proven", "exhausted_within_bounds", "sampled_budget_met", "truncated_unwind", "truncated_oom", "truncated_timeout"] },
        "linkage": { "type": "string", "enum": ["in_code_harness", "conformance_traced", "declared_model"] },
        "harness": { "type": "string", "minLength": 3 },
        "domain_bounds": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "enum": ["loop_unwind", "max_preemptions", "max_steps", "max_threads", "input_bytes", "qubits", "ansatz_layers", "circuit_depth"] },
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "cover_checks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "enum": ["satisfied", "unsatisfied", "unreachable"] }
        },
        "fairness": { "type": "string", "enum": ["none", "weak", "strong"] },
        "assumptions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_digests": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "reproducer": {
          "type": "object",
          "required": ["kind", "command", "witness"],
          "properties": {
            "kind": { "type": "string", "const": "counterexample_witness" },
            "command": { "type": "string", "minLength": 1 },
            "witness": {
              "type": "object",
              "required": ["when", "then"],
              "properties": {
                "when": { "type": "object" },
                "then": { "type": "object" }
              },
              "additionalProperties": false
            },
            "artifact_path": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "outcome": { "type": "string", "enum": ["passed", "violated", "inconclusive"] }
      }
    }
  }
}
