        "risk": {
          "description": "Risk ('1/4'..'4/4')",
          "enum": [
            "1/4",
            "2/4",
            "3/4",
            "4/4"
          ]
        },
        "undo": {
          "description": "easy, costly, one-way",
          "enum": [
            "easy",
            "costly",
            "one-way"
          ]
