{
  "$defs": {
    "case": {
      "additionalProperties": false,
      "dependentRequired": {
        "because": [
          "status"
        ],
        "status": [
          "because"
        ]
      },
      "properties": {
        "at": {
          "description": "Verification levels where this case must be proven (for example unit, http, or ui).",
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "because": {
          "description": "Mandatory rationale explaining why a case has a non-active status (such as deferred).",
          "minLength": 1,
          "type": "string"
        },
        "note": {
          "description": "Case-specific context note outside the behavioral digest.",
          "type": "string"
        },
        "scenario": {
          "description": "Short human-readable scenario label for reports and reviews.",
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "description": "Lifecycle exemption status (such as deferred or reviewed); omit for active cases.",
          "enum": [
            "deferred",
            "reviewed"
          ]
        },
        "then": {
          "additionalProperties": {
            "$ref": "#/$defs/constraint-value"
          },
          "description": "Expected postcondition predicate clauses or literals that must hold.",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": "object"
        },
        "when": {
          "additionalProperties": {
            "$ref": "#/$defs/constraint-value"
          },
          "description": "Input precondition predicate clauses or literals selecting this case.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": "object"
        },
        "writes": {
          "description": "Case-specific subset of scope.writes permitted to mutate ([] enforces a pure read/error frame).",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "then"
      ],
      "type": "object"
    },
    "concept": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "description": "Alternative terms normalized to preferred during vocabulary and recall checks.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "means": {
          "description": "Single-sentence domain definition of the concept.",
          "minLength": 1,
          "type": "string"
        },
        "predicates": {
          "additionalProperties": false,
          "description": "Profile when/then predicates governed by this concept.",
          "properties": {
            "then": {
              "items": {
                "pattern": "^[a-z][a-z0-9_]*$",
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            "when": {
              "items": {
                "pattern": "^[a-z][a-z0-9_]*$",
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            }
          },
          "type": "object"
        },
        "preferred": {
          "description": "Canonical domain identifier to use in contracts and code.",
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "replaced_by": {
          "description": "Successor concept identifier when deprecating a legacy term.",
          "pattern": "^(?:|[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*)$",
          "type": "string"
        }
      },
      "required": [
        "means"
      ],
      "type": "object"
    },
    "constraint-expr": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "eq"
          ]
        },
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "max"
          ]
        },
        {
          "required": [
            "len"
          ]
        },
        {
          "required": [
            "in"
          ]
        },
        {
          "required": [
            "not_in"
          ]
        },
        {
          "required": [
            "contains"
          ]
        },
        {
          "required": [
            "prefix"
          ]
        },
        {
          "required": [
            "suffix"
          ]
        },
        {
          "required": [
            "keys"
          ]
        },
        {
          "required": [
            "peer"
          ]
        },
        {
          "required": [
            "series"
          ]
        }
      ],
      "properties": {
        "contains": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "items": {
                "$ref": "#/$defs/toml-value"
              },
              "minItems": 1,
              "type": "array"
            }
          ],
          "description": "Substring or element that the observed string or collection must contain."
        },
        "convert_from": {
          "description": "Source unit key converted via profile [units] before comparison.",
          "minLength": 1,
          "type": "string"
        },
        "eq": {
          "$ref": "#/$defs/toml-value",
          "description": "Exact scalar, array, or map value expected."
        },
        "in": {
          "description": "Finite set of allowed values.",
          "items": {
            "$ref": "#/$defs/toml-value"
          },
          "minItems": 1,
          "type": "array"
        },
        "keys": {
          "additionalProperties": false,
          "description": "Map key allowlist or forbidlist constraints.",
          "minProperties": 1,
          "properties": {
            "allow": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "forbid": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          },
          "type": "object"
        },
        "len": {
          "additionalProperties": false,
          "description": "Collection or string length bounds ({min, max}).",
          "minProperties": 1,
          "properties": {
            "max": {
              "type": [
                "integer",
                "string"
              ]
            },
            "min": {
              "type": [
                "integer",
                "string"
              ]
            }
          },
          "type": "object"
        },
        "max": {
          "description": "Inclusive upper numeric bound.",
          "type": [
            "number",
            "string"
          ]
        },
        "min": {
          "description": "Inclusive lower numeric bound.",
          "type": [
            "number",
            "string"
          ]
        },
        "not_in": {
          "description": "Finite set of forbidden values.",
          "items": {
            "$ref": "#/$defs/toml-value"
          },
          "minItems": 1,
          "type": "array"
        },
        "peer": {
          "additionalProperties": false,
          "description": "Relational coupling against sibling when/then predicates (eq, le, ge, sum, or balance).",
          "minProperties": 1,
          "properties": {
            "balance": {
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "add": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "sub": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                }
              },
              "type": "object"
            },
            "eq": {
              "minLength": 1,
              "type": "string"
            },
            "ge": {
              "minLength": 1,
              "type": "string"
            },
            "le": {
              "minLength": 1,
              "type": "string"
            },
            "sum": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "type": "object"
        },
        "prefix": {
          "description": "Required string prefix.",
          "minLength": 1,
          "type": "string"
        },
        "series": {
          "additionalProperties": false,
          "description": "Sequence monotonicity, step delta, or sum-total invariant over ordered observations.",
          "minProperties": 1,
          "properties": {
            "monotonic": {
              "enum": [
                "non_decreasing",
                "increasing",
                "non_increasing",
                "decreasing"
              ]
            },
            "step_max_delta": {
              "type": [
                "number",
                "string"
              ]
            },
            "sum_total": {
              "type": [
                "number",
                "string"
              ]
            }
          },
          "type": "object"
        },
        "suffix": {
          "description": "Required string suffix.",
          "minLength": 1,
          "type": "string"
        },
        "tol": {
          "additionalProperties": false,
          "description": "Numeric approximation tolerance ({abs, rel}) paired with eq.",
          "minProperties": 1,
          "properties": {
            "abs": {
              "minimum": 0,
              "type": "number"
            },
            "rel": {
              "minimum": 0,
              "type": "number"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "constraint-value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/toml-value"
          },
          "type": "array"
        },
        {
          "$ref": "#/$defs/constraint-expr"
        }
      ]
    },
    "control": {
      "additionalProperties": false,
      "properties": {
        "cases": {
          "description": "Contract cases verifying this control.",
          "items": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "context_ref": {
          "description": "Validity-context envelope reference scoping external evidence.",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "criteria_ref": {
          "description": "Acceptance criteria reference for control evaluation.",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "effectiveness_evidence": {
          "description": "Receipt kinds proving operational effectiveness of the control.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "enforce": {
          "description": "Phase at which control evidence is required.",
          "enum": [
            "execution",
            "release"
          ]
        },
        "implementation_evidence": {
          "description": "Proof or receipt kinds attesting control implementation.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "kind": {
          "description": "Control classification (preventive, detective, or corrective).",
          "enum": [
            "software",
            "interface",
            "procedure",
            "hardware"
          ]
        },
        "mitigates": {
          "description": "Risk identifiers reciprocally mitigated by this control.",
          "items": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "note": {
          "description": "Supplemental control context outside the behavioral digest.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "mitigates"
      ],
      "type": "object"
    },
    "decision": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "assumption",
                  "divergence"
                ]
              }
            }
          },
          "then": {
            "required": [
              "source"
            ]
          }
        },
        {
          "else": {
            "required": [
              "revisit_if"
            ]
          },
          "if": {
            "properties": {
              "evidence": {
                "const": "observed"
              }
            }
          },
          "then": {}
        }
      ],
      "properties": {
        "ask": {
          "description": "Concise question (<= 120 chars) settled by this decision card.",
          "maxLength": 120,
          "type": "string"
        },
        "cases": {
          "description": "Contract or inherited profile cases affected by this decision.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "decide_by": {
          "description": "Latest phase by which pick must be chosen (approval, execution, or release).",
          "enum": [
            "approval",
            "execution",
            "release"
          ]
        },
        "evidence": {
          "description": "Epistemic grounding of the decision (observed, inferred, or assumed).",
          "enum": [
            "observed",
            "inferred",
            "assumed"
          ]
        },
        "kind": {
          "description": "Decision card category (choice, assumption, or divergence).",
          "enum": [
            "choice",
            "assumption",
            "divergence"
          ]
        },
        "note": {
          "description": "Supporting prose outside the digest.",
          "type": "string"
        },
        "options": {
          "additionalProperties": {
            "$ref": "#/$defs/option"
          },
          "description": "1 to 4 candidate options (<opt-id>) with effort, risk, undo, and complexity trade-offs.",
          "maxProperties": 4,
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": "object"
        },
        "owner": {
          "description": "Accountable decision owner notified on revisit or consumer impact.",
          "type": "string"
        },
        "pick": {
          "description": "Chosen option identifier, or '' while the decision remains open.",
          "type": "string"
        },
        "revisit_if": {
          "description": "Observable condition that reopens the card (required unless evidence is observed).",
          "type": "string"
        },
        "source": {
          "description": "Supporting ADR, specification section, or legacy file (required on assumption/divergence).",
          "type": "string"
        },
        "why": {
          "description": "One-line justification (required when pick costs more effort_h than an undominated option).",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ask",
        "pick",
        "cases",
        "evidence",
        "options"
      ],
      "type": "object"
    },
    "option": {
      "additionalProperties": false,
      "properties": {
        "complexity": {
          "description": "Anchored structural complexity rating ('1/4' to '4/4').",
          "enum": [
            "1/4",
            "2/4",
            "3/4",
            "4/4"
          ]
        },
        "confidence": {
          "description": "Anchored confidence in the estimate ('1/4' to '4/4').",
          "enum": [
            "1/4",
            "2/4",
            "3/4",
            "4/4"
          ]
        },
        "deps": {
          "description": "External components, libraries, or upstream contracts required by this option.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "does": {
          "description": "Concise summary (<= 100 chars) of what this option implements.",
          "maxLength": 100,
          "type": "string"
        },
        "effort_h": {
          "description": "Estimated implementation effort in hours.",
          "minimum": 0,
          "type": "number"
        },
        "leverage": {
          "description": "Anchored cross-slice reuse or simplification value ('1/4' to '4/4').",
          "enum": [
            "1/4",
            "2/4",
            "3/4",
            "4/4"
          ]
        },
        "parity": {
          "description": "Behavioral relationship to legacy/upstream baseline (same, extends, or diverges).",
          "enum": [
            "same",
            "diverges",
            "unknown"
          ]
        },
        "risk": {
          "description": "Anchored operational or regression risk ('1/4' to '4/4').",
          "enum": [
            "1/4",
            "2/4",
            "3/4",
            "4/4"
          ]
        },
        "undo": {
          "description": "Reversibility cost once deployed (easy, costly, or one-way).",
          "enum": [
            "easy",
            "costly",
            "one-way"
          ]
        }
      },
      "required": [
        "does",
        "complexity",
        "effort_h",
        "risk",
        "undo"
      ],
      "type": "object"
    },
    "risk": {
      "additionalProperties": false,
      "properties": {
        "controls": {
          "description": "Control identifiers reciprocally mitigating this risk.",
          "items": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "note": {
          "description": "Additional risk context.",
          "type": "string"
        },
        "summary": {
          "description": "Concise description of the failure mode or threat.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "summary",
        "controls"
      ],
      "type": "object"
    },
    "schema-pred": {
      "additionalProperties": false,
      "properties": {
        "compensating": {
          "description": "Whether this predicate represents a saga compensation action.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "enum": {
          "description": "Closed list of allowed string values for this predicate.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "len": {
          "additionalProperties": false,
          "description": "Length bounds ({min, max}) enforced on every value of this predicate.",
          "minProperties": 1,
          "properties": {
            "max": {
              "minimum": 0,
              "type": "integer"
            },
            "min": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "max": {
          "description": "Upper numeric domain bound enforced by the profile.",
          "type": "number"
        },
        "min": {
          "description": "Lower numeric domain bound enforced by the profile.",
          "type": "number"
        },
        "ptr": {
          "description": "RFC 6901 JSON Pointer (optionally <store>:/ptr) projecting payload observations.",
          "minLength": 1,
          "type": "string"
        },
        "role": {
          "description": "Semantic security or domain role (such as principal_tenant or resource_tenant).",
          "enum": [
            "state",
            "delivery_attempt",
            "classification",
            "encoding_context",
            "principal_tenant",
            "resource_tenant"
          ]
        },
        "transient": {
          "description": "Whether the predicate models a transient fault/retry state.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "type": {
          "description": "Static IR value type (bool, int, float, string, bytes, enum, array, map, or any).",
          "enum": [
            "bool",
            "int",
            "num",
            "string",
            "array",
            "map",
            "any"
          ]
        },
        "unit": {
          "description": "Canonical physical or monetary unit attached to this predicate.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "schema-side": {
      "additionalProperties": {
        "$ref": "#/$defs/schema-pred"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "type": "object"
    },
    "toml-value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/toml-value"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/toml-value"
          },
          "type": "object"
        }
      ]
    }
  },
  "$id": "urn:drift:schemas:profile:0.3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assurance": {
      "additionalProperties": false,
      "description": "Shared risk and control definitions inherited by contracts using this profile.",
      "properties": {
        "controls": {
          "additionalProperties": {
            "$ref": "#/$defs/control"
          },
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": "object"
        },
        "risks": {
          "additionalProperties": {
            "$ref": "#/$defs/risk"
          },
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "cases": {
      "additionalProperties": {
        "$ref": "#/$defs/case"
      },
      "description": "Baseline behavioral cases inherited by contracts (unless waived in [use].waive).",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "type": "object"
    },
    "concepts": {
      "additionalProperties": {
        "$ref": "#/$defs/concept"
      },
      "description": "Context-qualified domain concepts mapping canonical terms and aliases to profile predicates.",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
      },
      "type": "object"
    },
    "decisions": {
      "additionalProperties": {
        "$ref": "#/$defs/decision"
      },
      "description": "Reusable decision cards inherited by contracts using this profile.",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "type": "object"
    },
    "drift": {
      "const": "0.3",
      "description": "Normative DRIFT schema version ('0.3')."
    },
    "extends": {
      "description": "Parent profile references (<name>@<N>) whose schema, cases, and invariants this profile refines.",
      "items": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*@[1-9][0-9]*$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "invariants": {
      "additionalProperties": {
        "$ref": "#/$defs/constraint-value"
      },
      "description": "Postcondition constraints merged into every non-exempt case of contracts using this profile.",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "type": "object"
    },
    "kit": {
      "description": "Optional bridge helper or fixture kit identifier associated with this profile.",
      "type": "string"
    },
    "params": {
      "additionalProperties": {
        "oneOf": [
          {
            "enum": [
              "string",
              "int",
              "bool"
            ]
          },
          {
            "additionalProperties": false,
            "properties": {
              "max": {
                "type": "integer"
              },
              "min": {
                "type": "integer"
              },
              "role": {
                "const": "delivery_attempt"
              },
              "type": {
                "const": "int"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "compensating": {
                "items": {
                  "minLength": 1,
