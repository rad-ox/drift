{
  "$defs": {
    "approval": {
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "ref"
          ]
        },
        {
          "required": [
            "digest"
          ]
        }
      ],
      "properties": {
        "at": {
          "description": "RFC 3339 UTC timestamp when the approval was recorded.",
          "format": "date-time",
          "type": "string"
        },
        "by": {
          "description": "Identifier of the approving owner (must match policy.approvers when configured).",
          "minLength": 1,
          "type": "string"
        },
        "digest": {
          "description": "Full SHA-256 configuration digest seal.",
          "pattern": "^dr1:sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "ref": {
          "description": "Short or full digest reference sealing the configuration.",
          "pattern": "^dr1:[0-9a-f]{12}$",
          "type": "string"
        }
      },
      "required": [
        "by",
        "at"
      ],
      "type": "object"
    },
    "runnerProfile": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "description": "Command template executed for targeted/narrowed test runs.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "compile_scope": {
          "description": "Compilation boundary guaranteed by this runner (compile_and_run or test_only).",
          "enum": [
            "compile_and_run",
            "runtime_filter_only"
          ]
        },
        "cwd": {
          "description": "Working directory relative to the area root where the runner command executes.",
          "minLength": 1,
          "type": "string"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra static environment variables injected into runner invocations.",
          "type": "object"
        },
        "filter_mode": {
          "description": "How narrowed test selectors are passed to the runner command.",
          "enum": [
            "append_after_double_dash",
            "append",
            "mvn_dtest",
            "rust_test_exact",
            "none"
          ]
        },
        "match": {
          "description": "File path globs that bind matching contracts or code paths to this runner profile.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "widen_argv": {
          "description": "Fallback command template executed when selection widens to a full suite.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "argv"
      ],
      "type": "object"
    }
  },
  "$id": "urn:drift:schemas:config:0.3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {
    "type": "object"
  },
  "allOf": [
    {
      "else": {
        "minProperties": 3
      },
      "if": {
        "required": [
          "approval"
        ]
      },
      "then": {
        "minProperties": 4
      }
    }
  ],
  "properties": {
    "approval": {
      "$ref": "#/$defs/approval",
      "description": "Owner approval seal (dr1/dr2 ref, signer, and UTC timestamp) over the canonical configuration."
    },
    "drift": {
      "const": "0.3",
      "description": "Normative DRIFT schema version ('0.3')."
    },
    "kind": {
      "const": "config",
      "description": "Document kind discriminator ('config' for area configuration)."
    },
    "policy": {
      "description": "Area governance policy (pack, authorized approvers, minimum proof floor, ignores, and sweep mode).",
      "if": {
        "required": [
          "pack"
        ]
      },
      "then": {
        "additionalProperties": false,
        "properties": {
          "approvers": {
            "items": {
              "pattern": "^\\S(?:.*\\S)?$",
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "autonomy": {
            "additionalProperties": false,
            "properties": {
              "max_class": {
                "enum": [
                  "C0",
                  "C1"
                ]
              },
              "max_targets": {
                "minimum": 1,
                "type": "integer"
              },
              "principals": {
                "items": {
                  "pattern": "^agent:\\S+$",
                  "type": "string"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              }
            },
            "required": [
              "max_class",
              "principals",
              "max_targets"
            ],
            "type": "object"
          },
          "block_redundancy_erosion": {
            "type": "boolean"
          },
          "companion_edits": {
            "enum": [
              "none",
              "imports_only"
            ]
          },
          "forbid_imports": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "grant_lock": {
            "pattern": "^dr2g:(?:sha256:[0-9a-f]{64}|[0-9a-f]{12})$",
            "type": "string"
          },
          "ignore": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "max_lines": {
            "minimum": 1,
            "type": "integer"
          },
          "max_open": {
            "minimum": 1,
            "type": "integer"
          },
          "pack": {
            "const": "core@1"
          },
          "pact_locks": {
            "items": {
              "pattern": "^dr2p:(?:sha256:[0-9a-f]{64}|[0-9a-f]{12})$",
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "patch_scope": {
            "enum": [
              "optional",
              "required"
            ]
          },
          "performance_reuse": {
            "enum": [
              "off",
              "execution"
            ]
          },
          "priority_weights": {
            "additionalProperties": false,
            "properties": {
              "boundary_operator": {
                "maximum": 32,
                "minimum": 0,
                "type": "integer"
              },
              "fragile_card": {
                "maximum": 32,
                "minimum": 0,
                "type": "integer"
              },
              "security_case": {
                "maximum": 32,
                "minimum": 0,
                "type": "integer"
              },
              "shared_test": {
                "maximum": 32,
                "minimum": 0,
                "type": "integer"
              },
              "symmetric_witness": {
                "maximum": 32,
                "minimum": 0,
                "type": "integer"
              }
            },
            "type": "object"
          },
          "proof": {
            "enum": [
              "bound",
              "verified",
              "killed"
            ]
          },
          "require_observations": {
            "type": "boolean"
          },
          "require_signed_approval": {
            "type": "boolean"
          },
          "security": {
            "items": {
              "enum": [
                "sast",
                "fuzz",
                "policy",
                "deps"
              ]
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "signatures": {
            "type": "object"
          },
          "sweep": {
            "anyOf": [
              {
                "const": "soundness"
              },
              {
                "items": {
                  "const": "soundness"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              }
            ]
          },
          "uncovered": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "warn_ratio": {
            "exclusiveMaximum": 1,
            "exclusiveMinimum": 0,
            "type": "number"
          }
        },
        "required": [
          "pack",
          "approvers",
          "proof"
        ]
      },
      "type": "object"
    },
    "runners": {
      "additionalProperties": {
        "$ref": "#/$defs/runnerProfile"
      },
      "description": "Named test-runner profiles used by drift select --cmd and worker-pack execution.",
      "minProperties": 1,
      "type": "object"
    }
  },
  "required": [
    "drift",
    "kind"
  ],
  "title": "DRIFT 0.3 configuration",
  "type": "object"
}
