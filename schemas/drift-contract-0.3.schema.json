            "minLength": 3,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "max_lines": {
          "description": "Max lines per target file",
          "minimum": 1,
          "type": "integer"
        },
        "require_containment": {
          "description": "Require proof runners to run inside a verified containment sandbox.",
          "items": {
            "enum": [
              "no_network",
              "readonly_workspace"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "target": {
          "description": "Guarded file globs",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "target"
